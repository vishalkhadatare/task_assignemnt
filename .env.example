# 1Fi Smart EMI Platform — PostgreSQL Configuration Template
# Copy this file to .env and configure your PostgreSQL connection:

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres

# Alternatively, configure discrete connection parameters:
PGUSER=postgres
PGPASSWORD=your_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres

# Express Dev Server Port
PORT=3001
